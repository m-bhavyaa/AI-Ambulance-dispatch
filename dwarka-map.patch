new file mode 100644
index 0000000..2c094bd
--- /dev/null
+++ b/data/dwarka_data.py
@@ -0,0 +1,159 @@
+"""
+Dwarka (Delhi) real-map world.
+
+Loads the road graph produced by data/osm_builder.py and builds the same
+objects the rest of the system already uses: a CityGraph, Hospital and
+Ambulance objects, and emergency scenarios.
+
+Real vs simulated
+-----------------
+Real (from OpenStreetMap): road geometry, intersections, road names, hospital
+names and locations.
+Simulated (OpenStreetMap has no live data): beds, doctors, ICU availability,
+ambulance fleet and starting positions, traffic. These are generated
+deterministically (seeded) so the demo is repeatable.
+"""
+
+import hashlib
+import json
+import math
+import os
+import random
+
+from models.city_graph import CityGraph
+from models.hospital import Hospital
+from models.ambulance import Ambulance
+from data.osm_builder import DEFAULT_OUTPUT
+
+DATA_PATH = DEFAULT_OUTPUT
+
+# Equirectangular projection constants (km per degree)
+KM_PER_DEG_LAT = 110.574
+
+
+class DwarkaDataMissing(FileNotFoundError):
+    """Raised when data/dwarka_graph.json has not been generated yet."""
+
+
+def data_available(path=DATA_PATH):
+    return os.path.exists(path)
+
+
+def _load_json(path):
+    if not os.path.exists(path):
+        raise DwarkaDataMissing(
+            f"{path} not found. Run `python scripts/fetch_dwarka_osm.py` "
+            "on a machine with internet access (or use the button in the app).")
+    with open(path, encoding="utf-8") as fh:
+        return json.load(fh)
+
+
+def _seeded(name):
+    """Deterministic RNG for a name, stable across runs and machines."""
+    seed = int(hashlib.sha256(name.encode("utf-8")).hexdigest()[:12], 16)
+    return random.Random(seed)
+
+
+def create_dwarka_city_graph(data):
+    """
+    Build the CityGraph. Node (x, y) are projected kilometres, edge
+    base_distance is the real road length in kilometres, so A*'s straight-line
+    heuristic stays admissible (a road is never shorter than the straight
+    line between its ends).
+    """
+    nodes = data["nodes"]
+    lat0 = sum(n["lat"] for n in nodes.values()) / len(nodes)
+    lon0 = sum(n["lon"] for n in nodes.values()) / len(nodes)
+    km_per_deg_lon = 111.320 * math.cos(math.radians(lat0))
+
+    city = CityGraph()
+    for nid, n in nodes.items():
+        x = (n["lon"] - lon0) * km_per_deg_lon
+        y = (n["lat"] - lat0) * KM_PER_DEG_LAT
+        city.add_intersection(nid, x, y, lat=n["lat"], lon=n["lon"],
+                              label=n["label"], is_junction=n["is_junction"])
+
+    for e in data["edges"]:
+        u, v = e["u"], e["v"]
+        (x1, y1), (x2, y2) = city.get_position(u), city.get_position(v)
+        straight = math.hypot(x1 - x2, y1 - y2)
+        # max(): guards the tiny difference between projection and haversine
+        length = max(e["length_km"], straight)
+        city.add_road(u, v, traffic_factor=1.0, base_distance=length,
+                      name=e.get("name", ""), highway=e.get("highway", ""),
+                      geom=e["geom"], geom_from=u)
+    return city
+
+
+def create_dwarka_hospitals(data):
+    """
+    Hospitals with real names and locations. Resources are SIMULATED unless
+    OpenStreetMap carries a `beds` tag (then total beds is real).
+    """
+    hospitals = []
+    for h in data["hospitals"]:
+        rng = _seeded(h["name"])
+        total = h["beds"] if h.get("beds") and h["beds"] > 0 else rng.choice(
+            [30, 50, 80, 120, 200, 300])
+        available = max(1, int(total * rng.uniform(0.08, 0.35)))
+        icu = h.get("emergency") or rng.random() < 0.6
+        doctors = max(2, total // 10 + rng.randint(0, 3))
+        hospitals.append(Hospital(
+            name=h["name"], node=h["node"], total_beds=total,
+            available_beds=available, icu_available=bool(icu),
+            doctors_available=doctors, capacity_limit=int(total * 0.9)))
+    return hospitals
+
+
+def _spread_nodes(city, count, first=None):
+    """Farthest-point sampling over junctions, so picks are well spread."""
+    candidates = city.get_selectable_nodes()
+    if first is None:
+        cx = sum(city.get_position(n)[0] for n in candidates) / len(candidates)
+        cy = sum(city.get_position(n)[1] for n in candidates) / len(candidates)
+        first = min(candidates, key=lambda n: math.hypot(
+            city.get_position(n)[0] - cx, city.get_position(n)[1] - cy))
+    chosen = [first]
+    while len(chosen) < min(count, len(candidates)):
+        chosen.append(max(
+            (n for n in candidates if n not in chosen),
+            key=lambda n: min(city.euclidean_distance(n, c) for c in chosen)))
+    return chosen
+
+
+def create_dwarka_ambulances(city, count=4):
+    """Fleet placed at well-spread junctions. The last unit starts busy."""
+    speeds = [60, 55, 65, 60, 58, 62]
+    stations = _spread_nodes(city, count)
+    return [Ambulance(ambulance_id=f"AMB-{i + 1:02d}", current_node=node,
+                      is_available=(i < count - 1), speed=speeds[i % len(speeds)])
+            for i, node in enumerate(stations)]
+
+
+def create_dwarka_scenarios(city):
+    """Four ready-made emergencies at spread-out real intersections."""
+    nodes = _spread_nodes(city, 5)[1:]
+    kinds = [("Heart attack", "Critical", True), ("Road accident", "High", False),
+             ("Fall injury", "Medium", False), ("Stroke", "Critical", True)]
+    scenarios = []
+    for node, (kind, severity, icu) in zip(nodes, kinds):
+        scenarios.append({
+            "name": f"{kind} at {city.label(node)}",
+            "location": node, "severity": severity, "icu_required": icu,
+        })
+    return scenarios
+
+
+def load_dwarka_world(path=DATA_PATH):
+    """
+    Returns:
+        (city, hospitals, ambulances, scenarios, meta)
+    Raises:
+        DwarkaDataMissing if the OSM data file has not been generated.
+    """
+    data = _load_json(path)
+    city = create_dwarka_city_graph(data)
+    hospitals = create_dwarka_hospitals(data)
+    ambulances = create_dwarka_ambulances(city)
+    scenarios = create_dwarka_scenarios(city)
+    return city, hospitals, ambulances, scenarios, data.get("meta", {})
