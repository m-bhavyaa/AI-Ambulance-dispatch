new file mode 100644
index 0000000..adeec05
--- /dev/null
+++ b/data/osm_builder.py
@@ -0,0 +1,282 @@
+"""
+OpenStreetMap -> road graph builder for the Dwarka (Delhi) map mode.
+
+Two layers, so the logic can be tested without a network connection:
+
+  * build_graph_from_overpass(payload)  pure function: Overpass JSON -> dict
+  * fetch_and_build(...)                downloads from Overpass, then builds
+
+The resulting dict is saved to data/dwarka_graph.json and loaded by
+data/dwarka_data.py. Nodes are real road intersections, edges are road
+segments between them (with their curved geometry), hospitals come from the
+OSM `amenity=hospital` tag and are snapped to the nearest intersection.
+
+Roads are treated as two-way. Ambulances may legally use the opposite
+carriageway or median crossovers in an emergency, and OSM one-way tags would
+disconnect many dual-carriageway junctions in Dwarka.
+"""
+
+import json
+import math
+import os
+import time
+from collections import defaultdict
+
+# Dwarka sub-city, South West Delhi (south, west, north, east)
+DWARKA_BBOX = (28.545, 77.005, 28.625, 77.085)
+
+DEFAULT_OUTPUT = os.path.join(os.path.dirname(os.path.abspath(__file__)),
+                              "dwarka_graph.json")
+
+OVERPASS_MIRRORS = [
+    "https://overpass-api.de/api/interpreter",
+    "https://overpass.kumi.systems/api/interpreter",
+    "https://overpass.private.coffee/api/interpreter",
+]
+
+# "major": arterial + sector roads. "all" also adds residential streets
+# (much larger graph, slower A*, bigger map).
+HIGHWAY_CLASSES = {
+    "major": "motorway|trunk|primary|secondary|tertiary|"
+             "motorway_link|trunk_link|primary_link|secondary_link|tertiary_link",
+    "all": "motorway|trunk|primary|secondary|tertiary|unclassified|residential|"
+           "motorway_link|trunk_link|primary_link|secondary_link|tertiary_link",
+}
+
+EARTH_RADIUS_KM = 6371.0088
+MAX_HOSPITAL_SNAP_M = 600.0
+
+
+# ─────────────────────────── geometry helpers ───────────────────────────
+def haversine_km(lat1, lon1, lat2, lon2):
+    """Great-circle distance between two lat/lon points in kilometres."""
+    p1, p2 = math.radians(lat1), math.radians(lat2)
+    dphi = p2 - p1
+    dlmb = math.radians(lon2 - lon1)
+    a = math.sin(dphi / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dlmb / 2) ** 2
+    return 2 * EARTH_RADIUS_KM * math.asin(math.sqrt(a))
+
+
+def polyline_length_km(points):
+    """Length of a [[lat, lon], ...] polyline in kilometres."""
+    return sum(haversine_km(a[0], a[1], b[0], b[1])
+               for a, b in zip(points[:-1], points[1:]))
+
+
+# ─────────────────────────── Overpass queries ───────────────────────────
+def build_query(bbox=DWARKA_BBOX, detail="major", timeout=90):
+    """Overpass QL that returns roads (with geometry) and hospitals."""
+    s, w, n, e = bbox
+    classes = HIGHWAY_CLASSES[detail]
+    return (
+        f"[out:json][timeout:{timeout}];"
+        f'(way["highway"~"^({classes})$"]({s},{w},{n},{e}););'
+        f"out geom;"
+        f'(nwr["amenity"="hospital"]({s},{w},{n},{e}););'
+        f"out center tags;"
+    )
+
+
+def fetch_overpass(query, mirrors=None, timeout=120, retries=1):
+    """POST the query to Overpass mirrors until one answers. Needs `requests`."""
+    import requests  # imported lazily so the pure builder has no dependency
+
+    last_error = None
+    for url in (mirrors or OVERPASS_MIRRORS):
+        for attempt in range(retries + 1):
+            try:
+                resp = requests.post(
+                    url, data={"data": query}, timeout=timeout,
+                    headers={"User-Agent": "ai-emergency-dispatch-dwarka/1.0"})
+                if resp.status_code == 200:
+                    return resp.json()
+                last_error = f"{url} -> HTTP {resp.status_code}"
+            except Exception as exc:  # network, timeout, bad JSON
+                last_error = f"{url} -> {exc}"
+            time.sleep(2)
+    raise RuntimeError(f"Could not download OpenStreetMap data. Last error: {last_error}")
+
+
+# ─────────────────────────── graph construction ───────────────────────────
+def _road_name(tags):
+    return tags.get("name") or tags.get("ref") or tags.get("official_name") or ""
+
+
+def build_graph_from_overpass(payload, bbox=DWARKA_BBOX, detail="major"):
+    """
+    Convert an Overpass JSON payload (ways with geometry + hospital elements)
+    into a plain-dict road graph.
+
+    Returns:
+        dict with keys meta, nodes, edges, hospitals (JSON serialisable).
+
+    Raises:
+        ValueError: if the payload contains no usable road network.
+    """
+    elements = payload.get("elements", [])
+    ways = [e for e in elements
+            if e.get("type") == "way" and "geometry" in e and "nodes" in e
+            and "highway" in e.get("tags", {})]
+    if not ways:
+        raise ValueError("The OpenStreetMap response contains no road ways.")
+
+    # 1. Count how often each OSM node is used, to find junctions.
+    usage = defaultdict(int)
+    for way in ways:
+        for nid in way["nodes"]:
+            usage[nid] += 1
+
+    coords = {}
+    for way in ways:
+        for nid, pt in zip(way["nodes"], way["geometry"]):
+            if pt is not None:
+                coords[nid] = (pt["lat"], pt["lon"])
+
+    # 2. Split every way at junction nodes (used by 2+ ways / way endpoints).
+    segments = {}  # (u, v) sorted -> best segment
+    for way in ways:
+        nodes = way["nodes"]
+        geom = way["geometry"]
+        if len(nodes) < 2 or len(nodes) != len(geom) or any(g is None for g in geom):
+            continue
+        tags = way["tags"]
+        name = _road_name(tags)
+        highway = tags.get("highway", "")
+
+        def is_key(i):
+            return i == 0 or i == len(nodes) - 1 or usage[nodes[i]] >= 2
+
+        start = 0
+        for i in range(1, len(nodes)):
+            if not is_key(i):
+                continue
+            u, v = nodes[start], nodes[i]
+            pts = [[g["lat"], g["lon"]] for g in geom[start:i + 1]]
+            start = i
+            if u == v:
+                continue  # loop / roundabout stub
+            length = polyline_length_km(pts)
+            if length <= 0:
+                continue
+            key = (u, v) if u < v else (v, u)
+            seg = {"u": u, "v": v, "length_km": length,
+                   "name": name, "highway": highway, "geom": pts}
+            if key not in segments or length < segments[key]["length_km"]:
+                segments[key] = seg
+
+    if not segments:
+        raise ValueError("No road segments could be built from the response.")
+
+    # 3. Keep only the largest connected component (a routable network).
+    adjacency = defaultdict(set)
+    for (u, v) in segments:
+        adjacency[u].add(v)
+        adjacency[v].add(u)
+    seen, best = set(), set()
+    for root in adjacency:
+        if root in seen:
+            continue
+        stack, comp = [root], set()
+        while stack:
+            n = stack.pop()
+            if n in comp:
+                continue
+            comp.add(n)
+            stack.extend(adjacency[n] - comp)
+        seen |= comp
+        if len(comp) > len(best):
+            best = comp
+    segments = {k: s for k, s in segments.items() if s["u"] in best and s["v"] in best}
+
+    # 4. Node table with human-readable intersection labels.
+    degree = defaultdict(int)
+    road_names = defaultdict(list)
+    for s in segments.values():
+        for end in (s["u"], s["v"]):
+            degree[end] += 1
+            if s["name"] and s["name"] not in road_names[end]:
+                road_names[end].append(s["name"])
+
+    nodes = {}
+    for nid in best:
+        lat, lon = coords[nid]
+        names = road_names[nid]
+        if len(names) >= 2:
+            label = f"{names[0]} × {names[1]}"
+        elif len(names) == 1:
+            label = f"{names[0]} (junction {str(nid)[-5:]})"
+        else:
+            label = f"Junction {str(nid)[-6:]}"
+        nodes[str(nid)] = {
+            "lat": lat, "lon": lon, "label": label,
+            "degree": degree[nid],
+            "is_junction": degree[nid] >= 3,
+        }
+
+    edges = [{"u": str(s["u"]), "v": str(s["v"]),
+              "length_km": round(s["length_km"], 6),
+              "name": s["name"], "highway": s["highway"],
+              "geom": [[round(p[0], 6), round(p[1], 6)] for p in s["geom"]]}
+             for s in segments.values()]
+
+    # 5. Hospitals, snapped to the nearest graph node.
+    hospitals, seen_names = [], set()
+    node_items = [(nid, d["lat"], d["lon"]) for nid, d in nodes.items()]
+    for el in elements:
+        tags = el.get("tags", {})
+        if tags.get("amenity") != "hospital":
+            continue
+        name = tags.get("name:en") or tags.get("name")
+        if not name or name.lower() in seen_names:
+            continue
+        if "lat" in el and "lon" in el:
+            lat, lon = el["lat"], el["lon"]
+        elif "center" in el:
+            lat, lon = el["center"]["lat"], el["center"]["lon"]
+        else:
+            continue
+        snap_id, snap_km = min(
+            ((nid, haversine_km(lat, lon, nlat, nlon)) for nid, nlat, nlon in node_items),
+            key=lambda t: t[1])
+        if snap_km * 1000 > MAX_HOSPITAL_SNAP_M:
+            continue  # not actually on the mapped road network
+        seen_names.add(name.lower())
+        beds = None
+        try:
+            beds = int(str(tags.get("beds", "")).strip())
+        except ValueError:
+            pass
+        hospitals.append({
+            "name": name, "lat": lat, "lon": lon, "node": snap_id,
+            "snap_m": round(snap_km * 1000, 1),
+            "beds": beds,
+            "emergency": tags.get("emergency") == "yes",
+        })
+    hospitals.sort(key=lambda h: h["name"])
+
+    return {
+        "meta": {
+            "source": "OpenStreetMap contributors (ODbL), via Overpass API",
+            "bbox_south_west_north_east": list(bbox),
+            "detail": detail,
+            "fetched_at": time.strftime("%Y-%m-%d %H:%M:%S"),
+            "node_count": len(nodes),
+            "edge_count": len(edges),
+            "hospital_count": len(hospitals),
+        },
+        "nodes": nodes,
+        "edges": edges,
+        "hospitals": hospitals,
+    }
+
+
+def fetch_and_build(output_path=DEFAULT_OUTPUT, bbox=DWARKA_BBOX, detail="major"):
+    """Download Dwarka from OpenStreetMap, build the graph and save it as JSON."""
+    payload = fetch_overpass(build_query(bbox, detail))
+    data = build_graph_from_overpass(payload, bbox, detail)
+    if not data["hospitals"]:
+        raise RuntimeError("Road network downloaded but no hospitals were found "
+                           "near it. Try again or widen the bounding box.")
+    with open(output_path, "w", encoding="utf-8") as fh:
+        json.dump(data, fh, ensure_ascii=False, separators=(",", ":"))
+    return data["meta"]
